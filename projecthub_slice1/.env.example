# Copy this file to ".env" and fill in your values. NEVER commit ".env".
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
# mysql (default) or sqlite (quick tryout only)
DB_ENGINE=mysql
DB_NAME=baze_projecthub
DB_USER=projecthub_app
DB_PASSWORD=change-me
DB_HOST=127.0.0.1
DB_PORT=3306
# Email for registration decisions. Leave EMAIL_BACKEND unset to print emails in the server
# terminal; at launch use the SMTP backend with the details from Baze ICT.
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.example.org
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=True
# DEFAULT_FROM_EMAIL=Baze Project Hub <no-reply@bazeuniversity.edu.ng>
