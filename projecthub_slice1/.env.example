# Copy this file to ".env" and fill in your values. NEVER commit ".env".
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
# mysql (default) or sqlite (quick tryout only). DB_NAME and the DB_* settings below are for MySQL;
# SQLite uses SQLITE_PATH instead (default db.sqlite3 in this folder).
# SQLITE_PATH=db.sqlite3
DB_ENGINE=mysql
DB_NAME=baze_projecthub
DB_USER=projecthub_app
DB_PASSWORD=change-me
DB_HOST=127.0.0.1
DB_PORT=3306
# Email for registration decisions. Leave EMAIL_BACKEND unset to print emails in the server
# terminal; at launch use the SMTP backend with the details from Baze ICT.
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.example.org
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=True
# DEFAULT_FROM_EMAIL=Baze Project Hub <no-reply@bazeuniversity.edu.ng>
# Student ID format for registration (a regular expression) and the message shown when it does not
# match. Replace both with the real Baze format when it is confirmed.
# STUDENT_ID_REGEX=^[A-Za-z0-9]{5,15}$
# STUDENT_ID_HELP=5 to 15 letters or digits, with no spaces, slashes or other symbols
